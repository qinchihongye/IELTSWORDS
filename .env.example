# IELTSWORDS unified project environment
# Copy this file to .env and edit the values for your machine or server.

ENVIRONMENT=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8889
SERVER_RELOAD=true
SERVER_ACCESS_LOG=true
FRONTEND_PORT=8888

DATABASE_URL=sqlite:///./db/ielts_words_app.db
SOURCE_DATABASE_URL=sqlite:///./db/ielts_words.db

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Comma-separated origins without spaces.
CORS_ORIGINS=http://localhost:8888,http://127.0.0.1:8888,http://localhost:8890,http://127.0.0.1:8890
CORS_MAX_AGE=86400

# Dashboard performance tuning.
LEADERBOARD_CACHE_TTL_SECONDS=30

SECRET_KEY=replace-with-generated-secret
FERNET_KEY=replace-with-generated-fernet-key

# Berry system models
# Switch the default system model by changing OPENAI_DEFAULT_SYSTEM_MODEL_KEY.
OPENAI_DEFAULT_SYSTEM_MODEL_KEY=siliconflow_deepseek_v4_flash
OPENAI_SYSTEM_MODEL_KEYS=siliconflow_deepseek_v4_flash,deepseek_deepseek_v4_flash

OPENAI_SYSTEM_MODEL_SILICONFLOW_DEEPSEEK_V4_FLASH_PROVIDER=siliconflow
OPENAI_SYSTEM_MODEL_SILICONFLOW_DEEPSEEK_V4_FLASH_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_SYSTEM_MODEL_SILICONFLOW_DEEPSEEK_V4_FLASH_API_KEY=
OPENAI_SYSTEM_MODEL_SILICONFLOW_DEEPSEEK_V4_FLASH_MODEL=deepseek-ai/DeepSeek-V4-Flash
OPENAI_SYSTEM_MODEL_SILICONFLOW_DEEPSEEK_V4_FLASH_DISPLAY_NAME="deepseek-v4-flash (SiliconFlow)"

OPENAI_SYSTEM_MODEL_DEEPSEEK_DEEPSEEK_V4_FLASH_PROVIDER=deepseek
OPENAI_SYSTEM_MODEL_DEEPSEEK_DEEPSEEK_V4_FLASH_BASE_URL=https://api.deepseek.com
OPENAI_SYSTEM_MODEL_DEEPSEEK_DEEPSEEK_V4_FLASH_API_KEY=
OPENAI_SYSTEM_MODEL_DEEPSEEK_DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash
OPENAI_SYSTEM_MODEL_DEEPSEEK_DEEPSEEK_V4_FLASH_DISPLAY_NAME="deepseek-v4-flash (DeepSeek)"

# Legacy single-model fields kept only for compatibility with old scripts.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_DISPLAY_MODEL_NAME=gpt-4o-mini
# Optional: true/false. When set, sends chat_template_kwargs.enable_thinking.
OPENAI_ENABLE_THINKING=
AI_REQUEST_TIMEOUT_SECONDS=30

# Optional: Berry built-in web search. Fill these in .env only.
BOCHA_SEARCH_URL=
BOCHA_SEARCH_API_KEY=
BOCHA_SEARCH_FRESHNESS=oneWeek
BOCHA_SEARCH_COUNT=5
BOCHA_SEARCH_SUMMARY=true
BOCHA_SEARCH_TIMEOUT_SECONDS=15

VITE_API_BASE_URL=http://127.0.0.1:8889
