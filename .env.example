# IELTSWORDS unified project environment
# Copy this file to .env and edit the values for your machine or server.

ENVIRONMENT=development

SERVER_HOST=0.0.0.0
SERVER_PORT=5432
SERVER_RELOAD=true
SERVER_ACCESS_LOG=true
FRONTEND_PORT=5433

DATABASE_URL=sqlite:///./db/ielts_words_app.db
SOURCE_DATABASE_URL=sqlite:///./db/ielts_words.db

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Comma-separated origins without spaces.
CORS_ORIGINS=http://localhost:5433,http://127.0.0.1:5433,http://localhost:5434,http://127.0.0.1:5434
CORS_MAX_AGE=86400

# Dashboard performance tuning.
LEADERBOARD_CACHE_TTL_SECONDS=30

SECRET_KEY=replace-with-generated-secret
FERNET_KEY=replace-with-generated-fernet-key

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_DISPLAY_MODEL_NAME=gpt-4o-mini
# Optional: comma-separated model list for the in-app model selector.
OPENAI_MODELS=gpt-4o-mini,gpt-4o
# Optional: true/false. When set, sends chat_template_kwargs.enable_thinking.
OPENAI_ENABLE_THINKING=
AI_REQUEST_TIMEOUT_SECONDS=30

# Optional: Berry built-in web search. Fill these in .env only.
BOCHA_SEARCH_URL=
BOCHA_SEARCH_API_KEY=
BOCHA_SEARCH_FRESHNESS=noLimit
BOCHA_SEARCH_COUNT=5
BOCHA_SEARCH_SUMMARY=true
BOCHA_SEARCH_TIMEOUT_SECONDS=15

VITE_API_BASE_URL=http://127.0.0.1:5432
